# Copy to .env (never commit .env). All values optional; defaults shown.
DR_DATA_DIR=./data
DR_MODELS_DIR=./models
DR_OUTPUTS_DIR=./outputs
DR_DB_PATH=./database/dr_mlops.sqlite3
DR_SEED=42
DR_MAX_UPLOAD_BYTES=10485760
# acceptance policy (see src/evaluate.py)
DR_ACCEPT_MIN_DELTA_F1=0.0
DR_ACCEPT_MAX_ACC_DROP=0.02
DR_ACCEPT_MAX_RECALL_DROP=0.35
# automatic retraining trigger (used by the API in Phase 3)
DR_AUTO_RETRAIN=false
DR_AUTO_RETRAIN_MIN_NEW=50
DR_AUTO_RETRAIN_COOLDOWN_MIN=60

# --- deployment (Phase 5/6) ---
DR_API_URL=http://localhost:8000            # where the dashboard finds the API
DR_STATE_DIR=./state                        # DB + uploads + model versions (use /data on a Space with persistent storage)
DR_DASHBOARD_PASSWORD=                      # if set, Bulk upload / Retraining / rollback need this password
DR_API_KEY=                                 # if set, the API requires X-API-Key on upload/retrain/rollback
DR_AUTO_DOWNLOAD_DATASET=false              # try a direct download of the dataset at start-up (URL unverified)
